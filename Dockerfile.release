# syntax=docker/dockerfile:1

# The mc release image, ghcr.io/latere-ai/mc, built from this checkout by
# .github/workflows/release.yml. The build stage runs on the build host's
# platform and cross-compiles for the target, so no Go code runs under
# emulation, and the runtime stage has no RUN steps.
#
# LDFLAGS carries the version variables from buildscripts/gen-ldflags.go;
# the workflow computes them from the release tag.

FROM --platform=$BUILDPLATFORM golang:1.27.1-alpine3.24@sha256:8a5910f31396cd4d89662f56c68b3ae31d374308270a1c3bd96672ee5ed43414 AS build
ARG TARGETOS
ARG TARGETARCH
ARG LDFLAGS
ENV CGO_ENABLED=0 GOTOOLCHAIN=local
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN test -n "$LDFLAGS" \
 && GOOS=$TARGETOS GOARCH=$TARGETARCH \
    go build -tags kqueue -trimpath -buildvcs=false -ldflags "$LDFLAGS" -o /out/mc .

# Alpine rather than scratch: init steps run mc through `/bin/sh -c`.
FROM alpine:3.24.2@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6
ARG RELEASE
ARG COMMIT
LABEL org.opencontainers.image.title="mc" \
      org.opencontainers.image.description="MinIO Client (mc) ${RELEASE}, from the latere-ai/mc maintained fork" \
      org.opencontainers.image.version="${RELEASE}" \
      org.opencontainers.image.revision="${COMMIT}" \
      org.opencontainers.image.source="https://github.com/latere-ai/mc" \
      org.opencontainers.image.licenses="AGPL-3.0-or-later"
COPY --from=build /out/mc /usr/bin/mc
COPY LICENSE CREDITS /licenses/
ENTRYPOINT ["mc"]
